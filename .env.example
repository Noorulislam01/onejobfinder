# No environment variables are required for the Remote OK public jobs feed.
# Copy this file to .env.local for local development. Keep this file out of Git.
JOOBLE_API_KEY=
# Use the country host on which Jooble issued your key (for example, jooble.org or uk.jooble.org).
JOOBLE_API_HOST=in.jooble.org

# LinkedIn Job Search API from RapidAPI. Keep the key server-side; never use a VITE_ prefix.
LINKEDIN_JOBS_RAPIDAPI_KEY=
LINKEDIN_JOBS_RAPIDAPI_HOST=linkedin-job-search-api.p.rapidapi.com
